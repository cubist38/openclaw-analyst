# Active inference provider for all agents: openrouter or vllm.
#
# You may keep both OpenRouter and vLLM settings in this file, but this
# deployment generates one active OpenClaw model config from OPENCLAW_PROVIDER
# and OPENCLAW_MODEL on first boot.
#
# After changing OPENCLAW_PROVIDER, OPENCLAW_MODEL, credentials, or Telegram
# settings for an existing container, reset the persisted volume:
#   docker compose down -v
#   docker compose up -d --build
OPENCLAW_PROVIDER=openrouter

# OpenRouter credentials and default model.
# Get your key from https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-your-key-here
OPENCLAW_MODEL=openrouter/x-ai/grok-3-fast

# vLLM settings.
# Your vLLM server must expose OpenAI-compatible /v1 endpoints.
#
# To use vLLM as the active provider, change the two active lines above to:
#   OPENCLAW_PROVIDER=vllm
#   OPENCLAW_MODEL=vllm/meta-llama/Llama-3.1-8B-Instruct
#
# Docker cannot reach a host vLLM server via localhost. Use
# host.docker.internal for a vLLM server running on the Docker host, or use a
# LAN hostname/IP for a server on another machine.
VLLM_API_KEY=vllm-local
VLLM_BASE_URL=http://host.docker.internal:8000/v1
VLLM_MODEL_NAME=Local Llama 3.1 8B
VLLM_CONTEXT_WINDOW=128000
VLLM_MAX_TOKENS=8192
VLLM_REASONING=false

# Required — Create a bot via @BotFather on Telegram: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-your-token-here

# Required — Your Telegram numeric user ID (get it from @userinfobot: https://t.me/userinfobot)
# Comma-separated for multiple users: 123,456,789
TELEGRAM_ALLOW_FROM=123456789

# Optional — Timezone (default: UTC)
TZ=UTC
