# Default inference provider used by every agent that has no explicit
# per-agent model override (see "Per-agent model overrides" below): openrouter
# or vllm.
#
# You may keep both OpenRouter and vLLM settings in this file. On first boot,
# OPENCLAW_PROVIDER + OPENCLAW_MODEL set the global default; per-agent overrides
# can mix providers freely (e.g. concierge on OpenRouter, specialists on vLLM).
#
# After changing TELEGRAM_BOT_TOKEN or TELEGRAM_ALLOW_FROM for an existing
# container, reset the persisted volume:
#   docker compose down -v
#   docker compose up -d --build
# Model and provider changes are reconciled in place on restart — no volume
# reset needed.
OPENCLAW_PROVIDER=openrouter

# OpenRouter credentials and default model.
# Get your key from https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-your-key-here
OPENCLAW_MODEL=openrouter/x-ai/grok-3-fast

# vLLM settings.
# Your vLLM server must expose OpenAI-compatible /v1 endpoints.
#
# To use vLLM as the active provider, change the two active lines above to:
#   OPENCLAW_PROVIDER=vllm
#   OPENCLAW_MODEL=vllm/meta-llama/Llama-3.1-8B-Instruct
#
# Docker cannot reach a host vLLM server via localhost. Use
# host.docker.internal for a vLLM server running on the Docker host, or use a
# LAN hostname/IP for a server on another machine.
VLLM_API_KEY=vllm-local
VLLM_BASE_URL=http://host.docker.internal:8000/v1
VLLM_MODEL_NAME=Local Llama 3.1 8B
VLLM_CONTEXT_WINDOW=128000
VLLM_MAX_TOKENS=8192
VLLM_REASONING=false

# --- Per-agent model overrides (optional) ---
#
# Each variable below picks the model for one agent. Leave any of them unset
# to fall back to the global OPENCLAW_MODEL above. Mixing providers is
# supported — e.g. put the concierge on a stronger model via OpenRouter while
# keeping the heavyweight specialists on a self-hosted vLLM.
#
# Use the same `<provider>/<model-id>` form as OPENCLAW_MODEL. If any value
# below is `openrouter/...`, OPENROUTER_API_KEY must be set; if any is
# `vllm/...`, the VLLM_* settings must be filled in.
#
# Recommended baseline: keep specialists on vLLM (heavy SQL/Python turns), put
# the concierge on a strong instruction-follower so routing decisions and the
# "no-shell-glue" rules are honored reliably:
#   OPENCLAW_CONCIERGE_MODEL=openrouter/anthropic/claude-haiku-4-5
OPENCLAW_CONCIERGE_MODEL=
OPENCLAW_ANALYST_MODEL=
OPENCLAW_DS_MODEL=
OPENCLAW_CUSTOMER_MODEL=

# Required — Create a bot via @BotFather on Telegram: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-your-token-here

# Required — Your Telegram numeric user ID (get it from @userinfobot: https://t.me/userinfobot)
# Comma-separated for multiple users: 123,456,789
TELEGRAM_ALLOW_FROM=123456789

# MySQL database used by the analyst agents.
# MySQL imports database/init/*.sql only when the mysql-data volume is empty.
MYSQL_ROOT_PASSWORD=change-this-root-password
MYSQL_DATABASE=brewlytics
MYSQL_READONLY_USER=brewlytics_ro
MYSQL_READONLY_PASSWORD=change-this-readonly-password

# Optional — Timezone (default: UTC)
TZ=UTC
