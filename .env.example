# Required inference provider: openrouter or vllm
OPENCLAW_PROVIDER=openrouter

# OpenRouter example — get your key from https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-your-key-here
OPENCLAW_MODEL=openrouter/x-ai/grok-3-fast

# vLLM example — uncomment this block instead of OpenRouter.
# Your vLLM server must expose OpenAI-compatible /v1 endpoints.
# OPENCLAW_PROVIDER=vllm
# OPENCLAW_MODEL=vllm/meta-llama/Llama-3.1-8B-Instruct
# VLLM_API_KEY=vllm-local
# VLLM_BASE_URL=http://host.docker.internal:8000/v1
# VLLM_MODEL_NAME=Local Llama 3.1 8B
# VLLM_CONTEXT_WINDOW=128000
# VLLM_MAX_TOKENS=8192
# VLLM_REASONING=false

# Required — Create a bot via @BotFather on Telegram: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-your-token-here

# Required — Your Telegram numeric user ID (get it from @userinfobot: https://t.me/userinfobot)
# Comma-separated for multiple users: 123,456,789
TELEGRAM_ALLOW_FROM=123456789

# Optional — Timezone (default: UTC)
TZ=UTC
