# SPDX-License-Identifier: MIT
# Brewlytics derivative sandbox image for NemoClaw/OpenShell.
#
# Bakes our 4-agent source tree on top of NVIDIA's upstream OpenClaw sandbox,
# so the OpenShell runtime can drop us into a Landlock/seccomp/netns jail
# with only the egress we declared (api.telegram.org, the inference host).
#
# Secrets (bot token, API key) are NEVER baked into the image. openclaw.json
# and exec-approvals.json are symlinks from the Landlock-immutable /sandbox/.openclaw/
# into the writable /sandbox/.openclaw-data/, and entrypoint-sandbox.sh generates
# the real files at first boot from env vars passed through by `nemoclaw onboard`.
#
# Build:
#   docker build -f nemoclaw/Dockerfile.sandbox \
#                -t brewlytics-sandbox:$(git rev-parse --short HEAD) .
#   docker images --digests brewlytics-sandbox | head
#
# Then paste the sha256 digest into nemoclaw/blueprint.yaml (top `digest:`
# and `components.sandbox.image`).

# Upstream pin. Bump when NemoClaw's blueprint advances its pin —
# see github.com/NVIDIA/NemoClaw/blob/main/nemoclaw-blueprint/blueprint.yaml.
ARG UPSTREAM_DIGEST=sha256:b3d832b596ab6b7184a9dcb4ae93337ca32851a4f93b00765cc12de26baa3a9a

FROM ghcr.io/nvidia/openshell-community/sandboxes/openclaw@${UPSTREAM_DIGEST}

USER root

# System deps. pip wheels are installed here — runtime PyPI is NOT needed.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        python3 python3-pip sqlite3 \
        libfreetype6 libpng16-16 libfontconfig1 && \
    rm -rf /var/lib/apt/lists/*

# Source tree + generator — read-only at runtime under /app.
COPY --chown=sandbox:sandbox configs/                     /app/configs/
COPY --chown=sandbox:sandbox openclaw-config/             /app/openclaw-config/
COPY --chown=sandbox:sandbox generate_starbucks_db.py     /app/generate_starbucks_db.py
COPY --chown=sandbox:sandbox requirements.txt             /app/requirements.txt
COPY --chown=sandbox:sandbox nemoclaw/entrypoint-sandbox.sh /app/entrypoint-sandbox.sh

RUN pip3 install --no-cache-dir --break-system-packages -r /app/requirements.txt && \
    chmod +x /app/entrypoint-sandbox.sh

# Landlock makes /sandbox/.openclaw read-only at runtime. We pre-create symlinks
# here (at build time, when root can still write) that point into the writable
# /sandbox/.openclaw-data/ area. OpenClaw reads openclaw.json through the symlink
# — the target is generated at first boot with real env-var values, so no
# credentials live in the image.
RUN mkdir -p /sandbox/.openclaw /sandbox/.openclaw-data && \
    ln -sf /sandbox/.openclaw-data/openclaw.json       /sandbox/.openclaw/openclaw.json && \
    ln -sf /sandbox/.openclaw-data/exec-approvals.json /sandbox/.openclaw/exec-approvals.json && \
    chown -h sandbox:sandbox \
        /sandbox/.openclaw/openclaw.json \
        /sandbox/.openclaw/exec-approvals.json

USER sandbox

EXPOSE 18789

ENTRYPOINT ["/app/entrypoint-sandbox.sh"]
